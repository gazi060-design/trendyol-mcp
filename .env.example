# Global Trendyol environment
TRENDYOL_ENV=production

# N Trendyol stores, keyed by a short alias you will use in ChatGPT/MCP calls.
# Keep the whole JSON on one line in the real .env file.
TRENDYOL_STORES_JSON={"albeku":{"name":"Albeku","sellerId":"123456","apiKey":"your_api_key","apiSecret":"your_api_secret"},"magaza2":{"name":"Magaza 2","sellerId":"654321","apiKey":"your_api_key_2","apiSecret":"your_api_secret_2"}}

MCP_PORT=3000
MCP_API_TOKEN=change-me
